<odoo>
    <!-- Each series' sites (`website_ids`) are NOT set here: they are ids local to every
         database, and a module cannot know which of its sites belongs to the author. They
         are set from Besacraft > Series. The YouTube playlist names are left out for the
         same reason, plus one of their own: an update would overwrite a name changed by
         hand, which is exactly what happens to the series names below. -->
    <record id="serie_1722" model="besacraft.serie">
        <field name="name">Besacraft</field>
        <field name="code">1722</field>
        <field name="sequence">10</field>
        <field name="color">#C8AF8F</field>
        <field name="badge_ink">#323837</field>
        <field name="visual_mode">chronique</field>
    </record>
    <record id="serie_survie" model="besacraft.serie">
        <field name="name">Schematics / créatif</field>
        <field name="code">schematics</field>
        <field name="sequence">30</field>
        <field name="color">#478BB2</field>
        <field name="badge_ink">#FBFAF7</field>
        <field name="visual_mode">notice</field>
    </record>
    <record id="serie_hardcore" model="besacraft.serie">
        <field name="name">Les aventures de Zunk</field>
        <field name="code">hardcore</field>
        <field name="sequence">20</field>
        <field name="color">#C4583F</field>
        <field name="badge_ink">#EAD9B0</field>
        <field name="visual_mode">airain</field>
    </record>
    <!-- Empty for now: the series exists so that a first build has somewhere to go.
         The badge carries the average tone of the game's copper block (#C06C50), measured
         on its texture: the series' machines are made of copper, so the badge says so. It
         sits close to Zunk's red (#C4583F) because the two series overlap (the machines are
         used in the hardcore run), but the more orange cast keeps them apart. -->
    <record id="serie_steampunk" model="besacraft.serie">
        <field name="name">Steampunk</field>
        <field name="code">steampunk</field>
        <field name="sequence">40</field>
        <field name="color">#C06C50</field>
        <field name="badge_ink">#FBFAF7</field>
        <field name="visual_mode">airain</field>
    </record>
</odoo>
