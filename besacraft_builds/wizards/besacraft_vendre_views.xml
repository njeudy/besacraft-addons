<odoo>
    <record id="view_besacraft_vendre_form" model="ir.ui.view">
        <field name="name">besacraft.vendre.form</field>
        <field name="model">besacraft.vendre</field>
        <field name="arch" type="xml">
            <form string="Vendre ce build">
                <group>
                    <field name="build_id" invisible="1"/>
                    <field name="product_name"/>
                    <field name="price" widget="monetary"/>
                    <field name="serie_id" string="Collection"/>
                    <field name="block_count" string="Pièces"/>
                    <field name="with_media"/>
                </group>
                <footer>
                    <button name="action_vendre" type="object" string="Mettre en vente"
                            class="btn-primary"/>
                    <button special="cancel" string="Annuler" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
