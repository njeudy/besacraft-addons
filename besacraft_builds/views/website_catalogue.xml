<odoo>
    <!-- Pièces communes aux pages du catalogue (barre de section, carte, achat) puis le
         catalogue lui-même. Aucune teinte ni fonte ici : tout passe par les propriétés
         CSS « bc » (voir notice.scss) lues dans notice.scss et builds.scss, pour que les pages
         tiennent sous le thème clair de Besacraft comme sous le thème sombre du site de l'auteur. -->

    <!-- Barre de section, posée sous l'en-tête du site. `barre_active` vaut `projet`,
         `catalogue` ou le code d'une série : une seule entrée porte l'état actif. -->
    <template id="barre" name="Besacraft — Barre de section">
        <t t-set="bc_series" t-value="website._besacraft_series()"/>
        <nav class="bc-barre-section" aria-label="Builds Minecraft">
            <div class="bc-barre-in">
                <span class="bc-barre-marque">Builds</span>
                <ul>
                    <li t-if="website.besacraft_projet_url">
                        <a t-att-href="website.besacraft_projet_url"
                           t-attf-class="#{barre_active == 'projet' and 'bc-actif' or ''}"
                           t-att-aria-current="barre_active == 'projet' and 'page' or None">Le projet</a>
                    </li>
                    <li>
                        <a href="/builds"
                           t-attf-class="#{barre_active == 'catalogue' and 'bc-actif' or ''}"
                           t-att-aria-current="barre_active == 'catalogue' and 'page' or None">Catalogue</a>
                    </li>
                    <li t-foreach="bc_series" t-as="bc_serie">
                        <a t-attf-href="/builds/serie/#{bc_serie.code}"
                           t-attf-class="#{barre_active == bc_serie.code and 'bc-actif' or ''}"
                           t-att-aria-current="barre_active == bc_serie.code and 'page' or None"
                           t-out="bc_serie.name"/>
                    </li>
                </ul>
            </div>
        </nav>
    </template>

    <!-- La carte : un seul composant, réutilisé par le catalogue, la page de série, les
         builds voisins. `acquis` (ids que le visiteur possède) et `avec_boite` (ids qui ont
         une boîte) viennent du contrôleur : les deviner ici coûterait une requête par carte. -->
    <template id="carte" name="Besacraft — Carte de build">
        <t t-set="payant" t-value="build.enroll == 'payment'"/>
        <t t-set="acces" t-value="payant and 'payant' or (build.enroll == 'invite' and 'invite' or 'gratuit')"/>
        <a t-attf-href="/builds/#{int(build.code)}" class="bc-carte bc-lueur"
           t-att-data-code="build.code" t-att-data-serie="build.serie_id.code"
           t-att-data-blocs="build.block_count" t-att-data-couches="build.layer_count"
           t-att-data-acces="acces" t-att-data-nom="(build.name or '').lower()">
            <span class="bc-carte-tete">
                <span class="bc-carte-code">N°<t t-out="build.code"/></span>
                <span class="bc-carte-niv" t-out="build.NIVEAUX_COURT.get(build.level, '—')"/>
            </span>
            <span class="bc-carte-vis">
                <img t-attf-src="/web/image/besacraft.build/#{build.id}/#{build.id in avec_boite and 'box_image' or 'overview_image'}"
                     t-att-alt="'Boîte du build N°%s, %s' % (build.code, build.name)"
                     width="700" height="700" loading="lazy"/>
            </span>
            <span class="bc-carte-corps">
                <span class="bc-carte-nom" t-out="build.name"/>
                <span class="bc-pastille-serie" t-attf-style="--serie:#{build.serie_id.color}">
                    <i aria-hidden="true"/><t t-out="build.serie_id.name"/>
                </span>
                <span class="bc-carte-kv">
                    <span><b t-out="build.layer_count"/> couches</span>
                    <span><b t-out="'{:,}'.format(build.block_count).replace(',', ' ')"/> blocs</span>
                </span>
                <span class="bc-carte-pied">
                    <t t-if="build.enroll == 'invite'">
                        <span class="bc-acces bc-acces-invite">Sur invitation</span>
                    </t>
                    <t t-elif="payant and build.id in acquis">
                        <span class="bc-badge-achete">Acheté</span>
                    </t>
                    <t t-elif="payant">
                        <span class="bc-prix">
                            <svg class="bc-cadenas" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 1a3.5 3.5 0 0 0-3.5 3.5V7H3.5A1.5 1.5 0 0 0 2 8.5v5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5v-5A1.5 1.5 0 0 0 12.5 7h-1V4.5A3.5 3.5 0 0 0 8 1m2 6H6V4.5a2 2 0 1 1 4 0z"/></svg>
                            <span class="bc-prix-val" t-out="build.price_label"/>
                        </span>
                        <span class="bc-acces">Tuto payant</span>
                    </t>
                    <t t-else="">
                        <span class="bc-acces bc-acces-gratuit">Gratuit</span>
                    </t>
                </span>
            </span>
        </a>
    </template>

    <!-- Obtenir un tuto payant : le formulaire d'ajout au panier de la boutique. Le produit
         est lu sans droits de lecture sur product.product, mais l'identifiant suffit. -->
    <template id="achat" name="Besacraft — Achat d'un tuto">
        <t t-if="build.enroll == 'payment' and produit">
            <form action="/shop/cart/update" method="post" class="bc-achat-form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="product_id" t-att-value="produit.id"/>
                <input type="hidden" name="add_qty" value="1"/>
                <button type="submit" class="bc-btn-achat">
                    Obtenir ce tutoriel · <t t-out="build.price_label"/>
                </button>
            </form>
            <span class="bc-achat-note">La vue 3D, la liste cochable et la notice couche par
                couche s'ouvrent aussitôt.</span>
            <a t-att-href="produit.sudo().product_tmpl_id.website_url" class="bc-achat-fiche">
                Voir la fiche de la boutique</a>
        </t>
        <span t-elif="build.enroll == 'invite'" class="bc-achat-note">
            Ce tutoriel s'ouvre sur invitation.
        </span>
    </template>

    <template id="catalogue" name="Besacraft — Catalogue des builds">
        <t t-call="website.layout">
            <t t-set="additional_title">Catalogue des builds</t>
            <div id="wrap" class="bc-notice bc-catalogue">
                <t t-call="besacraft_builds.barre"/>
                <div class="bc-page">

                    <header class="bc-entete">
                        <div class="bc-entete-texte">
                            <span class="bc-surtitre">Builds &amp; tutos Minecraft</span>
                            <h1 class="bc-titre">Le catalogue</h1>
                            <p class="bc-compteur">
                                <span><b t-out="total"/> builds</span>
                                <span aria-hidden="true">·</span>
                                <span><b t-out="len(series)"/> séries</span>
                            </p>
                            <p class="bc-chapo">Chaque build est un bâtiment à monter couche par
                                couche, avec son nombre exact de blocs. Filtre par série ou par
                                accès, trie par taille ou par hauteur, ouvre une fiche.</p>
                        </div>
                    </header>

                    <section class="bc-pupitre" aria-label="Filtrer et trier le catalogue">
                        <div class="bc-rangee" role="group" aria-labelledby="bc-l-serie">
                            <span class="bc-label" id="bc-l-serie">Série</span>
                            <div class="bc-boutons">
                                <button type="button" class="bc-f" data-filtre="tout"
                                        t-att-aria-pressed="'false' if serie_active else 'true'">
                                    Toutes <b t-out="total"/>
                                </button>
                                <button t-foreach="series" t-as="s" type="button" class="bc-f"
                                        t-att-data-filtre="s.code"
                                        t-att-aria-pressed="'true' if serie_active == s.code else 'false'">
                                    <i class="bc-puce" aria-hidden="true" t-attf-style="background:#{s.color}"/>
                                    <t t-out="s.name"/> <b t-out="par_serie.get(s.id, 0)"/>
                                </button>
                            </div>
                        </div>
                        <div class="bc-rangee" role="group" aria-labelledby="bc-l-acces">
                            <span class="bc-label" id="bc-l-acces">Accès</span>
                            <div class="bc-boutons">
                                <button type="button" class="bc-f" data-acces-f="tout" aria-pressed="true">
                                    Tous <b t-out="total"/></button>
                                <button type="button" class="bc-f" data-acces-f="gratuit" aria-pressed="false">
                                    Gratuits <b t-out="n_gratuits"/></button>
                                <button type="button" class="bc-f" data-acces-f="payant" aria-pressed="false">
                                    Payants <b t-out="n_payants"/></button>
                            </div>
                        </div>
                        <div class="bc-rangee" role="group" aria-labelledby="bc-l-tri">
                            <span class="bc-label" id="bc-l-tri">Trier par</span>
                            <div class="bc-boutons">
                                <button type="button" class="bc-f" data-tri="code" data-sens="1" aria-pressed="true">
                                    N° <span class="bc-f-sens" aria-hidden="true">↑</span></button>
                                <button type="button" class="bc-f" data-tri="blocs" data-sens="-1" aria-pressed="false">
                                    Blocs <span class="bc-f-sens" aria-hidden="true">↓</span></button>
                                <button type="button" class="bc-f" data-tri="couches" data-sens="-1" aria-pressed="false">
                                    Couches <span class="bc-f-sens" aria-hidden="true">↓</span></button>
                            </div>
                        </div>
                        <div class="bc-rangee">
                            <label class="bc-label" for="bc-q">Chercher</label>
                            <input id="bc-q" type="search" class="bc-recherche" data-recherche="1"
                                   placeholder="Nom du build ou numéro" autocomplete="off"/>
                        </div>
                        <p class="bc-lecteur" aria-live="polite">
                            <b data-nb="1" t-out="total"/> builds affichés
                        </p>
                    </section>

                    <ul class="bc-grille">
                        <li t-foreach="builds" t-as="un_build" class="bc-cell">
                            <t t-call="besacraft_builds.carte"><t t-set="build" t-value="un_build"/></t>
                        </li>
                    </ul>

                    <div class="bc-vide" data-vide="*" hidden="hidden">
                        <span class="bc-vide-t">Aucun build ne correspond.</span>
                        <p>Essaie un autre filtre, ou efface la recherche.</p>
                    </div>
                    <div t-foreach="series" t-as="s" class="bc-vide" t-att-data-vide="s.code" hidden="hidden">
                        <span class="bc-vide-t">Les premiers tutos de la série arrivent</span>
                        <p><t t-out="s.name"/> n'a pas encore de build au catalogue.</p>
                        <a t-attf-href="/builds/serie/#{s.code}" class="bc-btn-second">Voir la page de la série</a>
                    </div>

                    <section class="bc-legende">
                        <span class="bc-legende-t">Lire une carte</span>
                        <p>Le <strong>N°</strong> est l'adresse du tuto : N°055, c'est
                            <code>/t/55</code>. Viennent ensuite le nombre de couches et de
                            blocs, comptés par le plan, et le niveau : <strong>Débutant</strong>
                            ne demande que du vanilla, <strong>Confirmé</strong> ajoute Domum
                            Ornamentum et Macaw's, <strong>Forgeron</strong> demande Create. En
                            bas de carte, <strong>Gratuit</strong> s'ouvre directement ; une plaque
                            de prix et un cadenas signalent un tuto payant, et
                            <strong>Acheté</strong> que tu l'as déjà.</p>
                    </section>

                </div>
            </div>
        </t>
    </template>
</odoo>
