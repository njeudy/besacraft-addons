<odoo>
    <!-- Fiche produit d'un tuto : la boîte de construction, façon boîte de jeu, avec le
         rendu du build à la place de l'illustration. Le code visuel est immédiatement lu :
         bandeau de marque, bandeau de thème, âge, numéro de set, nombre de pièces. -->
    <template id="produit_boite" inherit_id="website_sale.product"
              name="Besacraft — Boîte de construction">
        <xpath expr="//section[@id='product_detail']" position="before">
            <t t-set="build" t-value="product.sudo().besacraft_build_id"/>
            <div t-if="build" class="bc-notice bc-produit">
                <div class="bc-produit-haut">

                    <!-- La boîte n'est pas redessinée ici : c'est l'image du produit,
                         rendue dans Blender. Deux boîtes sur la même page, l'une dessinée
                         et l'autre photographiée, ne racontaient pas la même chose. -->
                    <img class="bc-produit-boite"
                         t-attf-src="/web/image/product.template/#{product.id}/image_1024"
                         t-att-alt="build.name"/>

                    <div class="bc-produit-texte">
                        <span class="bc-surtitre">
                            <t t-esc="build.serie_id.name"/> · Tuto n°<t t-esc="build.code"/>
                        </span>
                        <h1 class="bc-produit-titre" t-field="build.name"/>
                        <p class="bc-produit-accroche" t-field="build.accroche"/>

                        <div class="bc-fiche">
                            <span class="bc-fiche-c">
                                <span class="bc-fiche-l">Pièces</span>
                                <span class="bc-fiche-v"
                                      t-esc="'{:,}'.format(build.block_count).replace(',', ' ')"/>
                            </span>
                            <span class="bc-fiche-c">
                                <span class="bc-fiche-l">Couches</span>
                                <span class="bc-fiche-v" t-esc="build.layer_count"/>
                            </span>
                            <span class="bc-fiche-c">
                                <span class="bc-fiche-l">Emprise</span>
                                <span class="bc-fiche-v">
                                    <t t-esc="build.size_x"/><span class="bc-sep">×</span><t t-esc="build.size_y"/><span class="bc-sep">×</span><t t-esc="build.size_z"/>
                                </span>
                            </span>
                            <span class="bc-fiche-c">
                                <span class="bc-fiche-l">Niveau</span>
                                <span class="bc-fiche-v bc-fiche-mot"
                                      t-esc="dict(debutant='Débutant', confirme='Confirmé',
                                                  forgeron='Forgeron').get(build.level, '—')"/>
                            </span>
                            <span class="bc-fiche-c">
                                <span class="bc-fiche-l">Palette</span>
                                <span class="bc-fiche-v bc-fiche-mot" t-field="build.palette_label"/>
                            </span>
                            <span class="bc-fiche-c">
                                <span class="bc-fiche-l">Collection</span>
                                <span class="bc-fiche-v bc-fiche-mot" t-field="build.serie_id.name"/>
                            </span>
                        </div>

                        <div class="bc-inclus">
                            <span class="bc-inclus-t">Dans la boîte</span>
                            <ul>
                                <li>La vue 3D du build, à tourner et à parcourir couche par couche</li>
                                <li>La liste des blocs de chaque couche, cochable pendant que tu poses</li>
                                <li>La notice complète, couche par couche</li>
                                <li>Les recettes de fabrication et les matières premières</li>
                            </ul>
                            <span class="bc-inclus-n">
                                Pas de schematic : on construit soi-même, c'est le principe.
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
