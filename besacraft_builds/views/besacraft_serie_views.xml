<odoo>
    <record id="view_besacraft_serie_list" model="ir.ui.view">
        <field name="name">besacraft.serie.list</field>
        <field name="model">besacraft.serie</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="visual_mode"/>
                <field name="color"/>
                <field name="badge_ink"/>
                <field name="website_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="episode_count"/>
            </list>
        </field>
    </record>

    <record id="view_besacraft_serie_form" model="ir.ui.view">
        <field name="name">besacraft.serie.form</field>
        <field name="model">besacraft.serie</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <field name="subtitle" placeholder="Sous-titre"/>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="visual_mode"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="badge_ink"/>
                            <field name="website_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Episodes" name="episodes">
                            <field name="episode_ids">
                                <list>
                                    <field name="number"/>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="duration_minutes"/>
                                    <field name="is_published" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_serie" model="ir.actions.act_window">
        <field name="name">Series</field>
        <field name="res_model">besacraft.serie</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
