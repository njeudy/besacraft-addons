<odoo>
    <!-- Les fontes sont chargées une fois pour tout le site.

         Pas via `@import url()` dans le SCSS : l'URL de Google Fonts contient des `;` dans
         son paramètre `wght`, et le compilateur SCSS d'Odoo coupe la règle dessus -- ce qui
         casse le bundle frontend entier, pas seulement la fonte. Un <link> ne pose pas ce
         problème et précharge en parallèle. -->
    <template id="fontes" inherit_id="website.layout" name="Besacraft — fontes">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link rel="stylesheet"
                  href="https://fonts.googleapis.com/css2?family=VT323&amp;family=Anonymous+Pro:ital,wght@0,400;0,700;1,400&amp;display=swap"/>
        </xpath>
    </template>
</odoo>
