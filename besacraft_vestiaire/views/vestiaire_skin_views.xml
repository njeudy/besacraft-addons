<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_vestiaire" model="ir.ui.view">
        <field name="name">res.partner.form.vestiaire</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="vestiaire" string="Wardrobe"
                      groups="besacraft_vestiaire.group_vestiaire_admin">
                    <field name="vestiaire_skin_ids" context="{'default_partner_id': id}">
                        <list editable="bottom">
                            <field name="image" widget="image" options="{'size': [48, 48]}"/>
                            <field name="name"/>
                            <field name="modele"/>
                            <field name="actif"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
