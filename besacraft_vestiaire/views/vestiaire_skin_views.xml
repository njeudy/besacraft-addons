<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_vestiaire" model="ir.ui.view">
        <field name="name">res.partner.form.vestiaire</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="vestiaire" string="Wardrobe"
                      groups="besacraft_vestiaire.group_vestiaire_admin">
                    <button name="action_vestiaire_importer_skin_mojang" type="object"
                            string="Import Mojang skin"/>
                    <field name="vestiaire_skin_ids" context="{'default_partner_id': id}">
                        <list editable="bottom">
                            <field name="image" widget="image" options="{'size': [48, 48]}"/>
                            <field name="name"/>
                            <field name="modele"/>
                            <field name="actif"/>
                        </list>
                    </field>
                    <button name="%(besacraft_vestiaire.vestiaire_offrir_action)d" type="action"
                            string="Give"/>
                    <group>
                        <field name="vestiaire_cape_id"/>
                    </group>
                    <field name="vestiaire_possession_ids" context="{'default_partner_id': id}">
                        <list editable="bottom">
                            <field name="cape_id"/>
                            <field name="cosmetique_id"/>
                            <field name="origine"/>
                            <field name="date"/>
                        </list>
                    </field>
                    <group>
                        <field name="vestiaire_points"/>
                        <field name="vestiaire_tenue_ids" widget="many2many_tags"/>
                    </group>
                    <field name="vestiaire_case_ids" context="{'default_partner_id': id}">
                        <list editable="bottom">
                            <field name="index"/>
                            <field name="emote_id"/>
                        </list>
                    </field>
                    <field name="vestiaire_mouvement_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="motif"/>
                            <field name="libelle"/>
                            <field name="reference"/>
                            <field name="points" sum="Balance"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
