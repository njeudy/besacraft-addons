<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vestiaire_cosmetique_view_list" model="ir.ui.view">
        <field name="name">besacraft.vestiaire.cosmetique.list</field>
        <field name="model">besacraft.vestiaire.cosmetique</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="genre"/>
                <field name="emplacement"/>
                <field name="prix"/>
                <field name="de_base"/>
                <field name="publie"/>
                <field name="distant" optional="show"/>
            </list>
        </field>
    </record>

    <record id="vestiaire_cosmetique_view_form" model="ir.ui.view">
        <field name="name">besacraft.vestiaire.cosmetique.form</field>
        <field name="model">besacraft.vestiaire.cosmetique</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="vignette" widget="image" class="oe_avatar" invisible="not vignette"/>
                    <field name="apercu_url" widget="image_url" class="oe_avatar o_vestiaire_pixel"
                           options="{'size': [128, 128]}" invisible="vignette"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="genre"/>
                            <field name="emplacement" invisible="genre != 'cosmetique'"/>
                        </group>
                        <group>
                            <field name="prix"/>
                            <field name="de_base"/>
                            <field name="publie"/>
                        </group>
                        <group>
                            <field name="vignette" widget="image" options="{'size': [64, 64]}"
                                   string="Custom thumbnail"/>
                            <field name="createur_id"/>
                            <field name="source"/>
                            <field name="licence"/>
                        </group>
                    </group>
                    <notebook invisible="genre != 'cosmetique'">
                        <page name="distant" string="Remote files">
                            <div class="text-muted mb-2">Drop the zip made by <code>generer.py --paquet</code>: the game then downloads this cosmetic from Odoo, no new mod version needed. Each accepted package raises the version.</div>
                            <group>
                                <group>
                                    <field name="paquet" filename="paquet_nom"/>
                                    <field name="paquet_nom" invisible="1"/>
                                    <field name="distant"/>
                                    <field name="version_distante"/>
                                </group>
                                <group>
                                    <button name="action_retirer_paquet" type="object"
                                            string="Remove the package" invisible="not distant"
                                            confirm="The game will draw this cosmetic from the jar only, if the jar has it. Continue?"/>
                                </group>
                            </group>
                            <field name="fichier_ids" readonly="1">
                                <list>
                                    <field name="chemin"/>
                                    <field name="taille"/>
                                    <field name="sha256"/>
                                </list>
                            </field>
                            <field name="entree_distante" invisible="not entree_distante"
                                   widget="code" options="{'mode': 'javascript'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- The picture comes from the thumbnail when set, otherwise from the static file named
         after the code. Emotes always use their animated GIF: an Image field would flatten it. -->
    <record id="vestiaire_cosmetique_view_kanban" model="ir.ui.view">
        <field name="name">besacraft.vestiaire.cosmetique.kanban</field>
        <field name="model">besacraft.vestiaire.cosmetique</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="code"/>
                <field name="genre"/>
                <field name="vignette"/>
                <field name="de_base"/>
                <field name="prix"/>
                <field name="publie"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <widget name="web_ribbon" title="Unpublished" bg_color="text-bg-secondary"
                                invisible="publie"/>
                        <aside class="d-flex align-items-center justify-content-center me-2">
                            <t t-if="record.genre.raw_value == 'emote'">
                                <img t-attf-src="/besacraft_vestiaire/static/img/emotes/{{ record.code.raw_value }}.gif"
                                     class="o_vestiaire_pixel o_vestiaire_vignette" alt="Emote"
                                     loading="lazy" onerror="this.style.display='none'"/>
                            </t>
                            <field t-elif="record.vignette.raw_value" name="vignette" widget="image"
                                   class="o_vestiaire_pixel"
                                   options="{'size': [96, 96], 'img_class': 'object-fit-contain'}"/>
                            <img t-else=""
                                 t-attf-src="/besacraft_vestiaire/static/img/cosmetiques/{{ record.code.raw_value }}.png"
                                 class="o_vestiaire_pixel o_vestiaire_vignette" alt="Cosmetic"
                                 loading="lazy" onerror="this.style.display='none'"/>
                        </aside>
                        <main>
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="code" class="text-muted small"/>
                            <field t-if="record.emplacement.raw_value" name="emplacement"
                                   class="d-block"/>
                            <div class="mt-1">
                                <span t-if="record.de_base.raw_value" class="badge text-bg-info">Base</span>
                                <span t-elif="record.prix.raw_value" class="badge text-bg-primary">
                                    <field name="prix"/> pts
                                </span>
                                <span t-else="" class="badge text-bg-secondary">Reserved</span>
                                <span t-if="!record.de_base.raw_value" class="ms-2 text-muted">
                                    <i class="fa fa-users me-1" title="Owners"/>
                                    <field name="possesseur_count"/>
                                </span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="vestiaire_cosmetique_view_search" model="ir.ui.view">
        <field name="name">besacraft.vestiaire.cosmetique.search</field>
        <field name="model">besacraft.vestiaire.cosmetique</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="cosmetiques" string="Cosmetics" domain="[('genre', '=', 'cosmetique')]"/>
                <filter name="emotes" string="Emotes" domain="[('genre', '=', 'emote')]"/>
                <separator/>
                <filter name="en_vente" string="For sale" domain="[('prix', '>', 0)]"/>
                <filter name="de_base" string="Owned by everyone" domain="[('de_base', '=', True)]"/>
                <filter name="non_publie" string="Unpublished" domain="[('publie', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="par_genre" string="Kind" context="{'group_by': 'genre'}"/>
                    <filter name="par_emplacement" string="Slot" context="{'group_by': 'emplacement'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vestiaire_cosmetique_action" model="ir.actions.act_window">
        <field name="name">Cosmetics</field>
        <field name="res_model">besacraft.vestiaire.cosmetique</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('genre', '=', 'cosmetique')]</field>
        <field name="context">{'default_genre': 'cosmetique'}</field>
    </record>

    <record id="vestiaire_emote_action" model="ir.actions.act_window">
        <field name="name">Emotes</field>
        <field name="res_model">besacraft.vestiaire.cosmetique</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('genre', '=', 'emote')]</field>
        <field name="context">{'default_genre': 'emote'}</field>
    </record>

    <record id="vestiaire_mouvement_view_list" model="ir.ui.view">
        <field name="name">besacraft.vestiaire.mouvement.list</field>
        <field name="model">besacraft.vestiaire.mouvement</field>
        <field name="arch" type="xml">
            <list create="1" edit="0" delete="0">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="motif"/>
                <field name="libelle"/>
                <field name="reference"/>
                <field name="cosmetique_id" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="points" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="vestiaire_mouvement_view_form" model="ir.ui.view">
        <field name="name">besacraft.vestiaire.mouvement.form</field>
        <field name="model">besacraft.vestiaire.mouvement</field>
        <field name="arch" type="xml">
            <form edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="points"/>
                        <field name="motif"/>
                        <field name="libelle"/>
                        <field name="reference"/>
                        <field name="cosmetique_id"/>
                        <field name="date"/>
                        <field name="user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vestiaire_mouvement_view_search" model="ir.ui.view">
        <field name="name">besacraft.vestiaire.mouvement.search</field>
        <field name="model">besacraft.vestiaire.mouvement</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="reference"/>
                <group expand="0" string="Group By">
                    <filter name="par_joueur" string="Player" context="{'group_by': 'partner_id'}"/>
                    <filter name="par_motif" string="Reason" context="{'group_by': 'motif'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vestiaire_mouvement_action" model="ir.actions.act_window">
        <field name="name">Points movements</field>
        <field name="res_model">besacraft.vestiaire.mouvement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_motif': 'correction'}</field>
    </record>

    <record id="vestiaire_bareme_view_list" model="ir.ui.view">
        <field name="name">besacraft.vestiaire.bareme.list</field>
        <field name="model">besacraft.vestiaire.bareme</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="motif"/>
                <field name="code"/>
                <field name="name"/>
                <field name="points"/>
            </list>
        </field>
    </record>

    <record id="vestiaire_bareme_action" model="ir.actions.act_window">
        <field name="name">Points scale</field>
        <field name="res_model">besacraft.vestiaire.bareme</field>
        <field name="view_mode">list</field>
    </record>

    <record id="vestiaire_cle_serveur_view_list" model="ir.ui.view">
        <field name="name">besacraft.vestiaire.cle.serveur.list</field>
        <field name="model">besacraft.vestiaire.cle.serveur</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="derniere_utilisation"/>
                <field name="active" widget="boolean_toggle"/>
                <button name="action_generer" type="object" string="New key"
                        confirm="The previous key of this server will stop working."/>
            </list>
        </field>
    </record>

    <record id="vestiaire_cle_serveur_action" model="ir.actions.act_window">
        <field name="name">Server keys</field>
        <field name="res_model">besacraft.vestiaire.cle.serveur</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="menu_vestiaire_cosmetiques" name="Cosmetics"
              parent="menu_vestiaire_root" action="vestiaire_cosmetique_action"
              groups="besacraft_vestiaire.group_vestiaire_createur" sequence="20"/>
    <menuitem id="menu_vestiaire_emotes" name="Emotes"
              parent="menu_vestiaire_root" action="vestiaire_emote_action"
              groups="besacraft_vestiaire.group_vestiaire_createur" sequence="30"/>
    <menuitem id="menu_vestiaire_mouvements" name="Points movements"
              parent="menu_vestiaire_root" action="vestiaire_mouvement_action"
              groups="besacraft_vestiaire.group_vestiaire_admin" sequence="60"/>
    <menuitem id="menu_vestiaire_configuration" name="Configuration"
              parent="menu_vestiaire_root"
              groups="besacraft_vestiaire.group_vestiaire_admin" sequence="90"/>
    <menuitem id="menu_vestiaire_bareme" name="Points scale"
              parent="menu_vestiaire_configuration" action="vestiaire_bareme_action"
              groups="besacraft_vestiaire.group_vestiaire_admin" sequence="10"/>
    <menuitem id="menu_vestiaire_cles" name="Server keys"
              parent="menu_vestiaire_configuration" action="vestiaire_cle_serveur_action"
              groups="besacraft_vestiaire.group_vestiaire_admin" sequence="20"/>
</odoo>
