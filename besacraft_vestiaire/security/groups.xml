<odoo>
    <record id="module_category_vestiaire" model="ir.module.category">
        <field name="name">Besacraft Wardrobe</field>
    </record>
    <record id="group_vestiaire_createur" model="res.groups">
        <field name="name">Creator</field>
        <field name="category_id" ref="module_category_vestiaire"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_vestiaire_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_vestiaire"/>
        <field name="implied_ids" eval="[(4, ref('group_vestiaire_createur'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
