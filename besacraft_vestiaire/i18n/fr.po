#. module: besacraft_vestiaire
#: model:mail.template,body_html:besacraft_vestiaire.mail_demande_refusee
msgid ""
"<p>Hello <t t-out=\"object.prenom\"/>,</p>\n"
"            <p>Your Besacraft account request was not accepted.</p>\n"
"            <p t-if=\"object.message_refus\"><t t-out=\"object.message_refus\"/></p>\n"
"        "
msgstr ""
"<p>Bonjour <t t-out=\"object.prenom\"/>,</p>\n"
"            <p>Ta demande de compte Besacraft n'a pas été acceptée.</p>\n"
"            <p t-if=\"object.message_refus\"><t t-out=\"object.message_refus\"/></p>\n"
"        "

#. module: besacraft_vestiaire
#: model:mail.template,body_html:besacraft_vestiaire.mail_parent_info
msgid ""
"<p>Hello,</p>\n"
"            <p><t t-out=\"object.prenom\"/> (Minecraft: <t t-out=\"object.pseudo\"/>) now has a\n"
"               Besacraft account. An invitation was sent to <t t-out=\"object.email\"/>.</p>\n"
"            <p>Reply to this email if you did not expect it.</p>\n"
"        "
msgstr ""
"<p>Bonjour,</p>\n"
"            <p><t t-out=\"object.prenom\"/> (Minecraft : <t t-out=\"object.pseudo\"/>) a maintenant un\n"
"               compte Besacraft. Une invitation a été envoyée à <t t-out=\"object.email\"/>.</p>\n"
"            <p>Répondez à cet e-mail si vous ne vous y attendiez pas.</p>\n"
"        "

#. module: besacraft_vestiaire
#: model_terms:ir.ui.view,arch_db:besacraft_vestiaire.portal_vestiaire
