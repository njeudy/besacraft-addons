<odoo>
    <record id="cron_purger_codes" model="ir.cron">
        <field name="name">Wardrobe: purge expired request codes</field>
        <field name="model_id" ref="model_besacraft_vestiaire_code"/>
        <field name="state">code</field>
        <field name="code">model._purger()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_importer_skins_mojang" model="ir.cron">
        <field name="name">Wardrobe: seed skins from Mojang</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._vestiaire_cron_importer_skins()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
