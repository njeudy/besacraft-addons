<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="product_template_form_besacraft" model="ir.ui.view">
    <field name="name">product.template.form.besacraft</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='type']" position="after">
        <field name="est_ressource_besacraft"/>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page name="besacraft" string="Ressources Besacraft"
              invisible="not est_ressource_besacraft">
          <p class="text-muted">
            Les blocs que l'achat de ce produit crédite au serveur. Ils sont livrés à la
            réception du 97 rue Battant, dans la dimension Besançon.
          </p>
          <field name="besacraft_line_ids">
            <list editable="bottom">
              <field name="sequence" widget="handle"/>
              <field name="image_1920" widget="image" options="{'size': [28, 28]}"/>
              <field name="item_id"/>
              <field name="identifiant"/>
              <field name="quantite" sum="Total"/>
            </list>
          </field>
          <group class="mt-2">
            <field name="besacraft_total" string="Blocs au total"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>

</odoo>
